---
import Layout from "@/layouts/Layout.astro";
import Visualizer from "@/components/Visualizer.tsx";
import { Badge } from "@/components/ui/badge";
import "@/styles/global.css";

const GITHUB_URL = "https://github.com/tinycomputers/tiny-tpu";
---

<Layout
  title="TinyTPU Visualizer — Interactive Systolic Array Simulator"
  description="Interactive TPU simulator: enter matrices and watch a 4×4 systolic array visualizer execute matrix multiply from real SystemVerilog RTL via WebAssembly."
  preloadWasm={true}
>
  <div class="flex min-h-screen flex-col page">
    <!-- Nav - NOT sticky; the visualizer is a full-page tool, sticky overlaps content -->
    <header class="nav-wrap">
      <nav class="container nav" aria-label="Site navigation">
        <a href="/" class="logo" aria-label="TinyTPU home">
          <span class="logo-text">Tiny<strong>TPU</strong></span>
          <span class="logo-badge">RTL</span>
        </a>

        <div class="nav-links" role="list">
          <a href="/#features" role="listitem">Features</a>
          <a href="/#pipeline" role="listitem">Pipeline</a>
          <a href="/app" class="active" role="listitem">Visualizer</a>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
          >GitHub</a>
        </div>

        <div class="nav-actions">
          <!-- Theme toggle -->
          <button
            id="theme-toggle"
            class="theme-btn"
            aria-label="Switch to light mode"
            title="Toggle theme"
            type="button"
          >
            <!-- Moon: shown in dark mode -->
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <!-- Sun: shown in light mode -->
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Visualizer -->
    <main class="flex-1 container py-8 md:py-12 flex flex-col items-center gap-6">
      <header class="text-center flex flex-col items-center gap-2.5 max-w-xl">
        <Badge variant="outline" className="font-mono text-[10px] tracking-wider uppercase flex items-center gap-2 border-border bg-muted/20 text-cyan-400 py-1 px-3">
          Interactive Instrument
        </Badge>
        <h1 class="text-2xl font-extrabold tracking-tight md:text-3xl text-foreground leading-tight">
          4×4 Systolic Array
        </h1>
        <p class="text-xs text-muted-foreground uppercase tracking-wider font-mono">
          Weight-stationary dataflow · real RTL compiled to WASM · live from hardware
        </p>
      </header>

      <div class="w-full max-w-[860px]">
        <Visualizer client:only="react" />
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-hairline py-6 mt-auto">
      <div class="container flex items-center justify-between text-[0.62rem] text-muted-foreground font-mono uppercase tracking-wider">
        <div class="flex items-center gap-4">
          <a href="/" class="transition-colors hover:text-foreground">Home</a>
          <span>·</span>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-foreground"
          >
            GitHub
          </a>
        </div>
        <span>MIT License</span>
      </div>
    </footer>
  </div>
</Layout>
