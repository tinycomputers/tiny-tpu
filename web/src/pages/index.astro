/* Cell entrance: fade + subtle upward slide, staggered diagonally */
@keyframes cell-in {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.pe-cell {
  position: relative;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border: 1px solid var(--hairline-strong);
  background: color-mix(in oklch, var(--surface-deep) 70%, transparent);
  border-radius: 5px;
  overflow: hidden;
  /* entrance animation uses delay, not duration */
  opacity: 0;
  animation: cell-in 280ms cubic-bezier(0.25, 0.46, 0.45, 0.94)
             var(--entrance-delay, 0ms) forwards;
}

.pe-name {
  font-family: var(--font-mono);
  font-size: 0.5rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted-foreground);
  line-height: 1;
}

.pe-idx {
  font-family: var(--font-mono);
  font-size: 0.4rem;
  color: oklch(0.42 0.01 215);
  line-height: 1;
}

/* ── Active diagonal: lime border + background tint ── */
.pe-cell.pe-active {
  border-color: color-mix(in oklch, var(--signal-lime) 60%, var(--hairline-strong));
  background: color-mix(in oklch, var(--signal-lime) 9%, var(--surface-deep));
}

.pe-cell.pe-active .pe-name { color: var(--signal-lime); }
.pe-cell.pe-active .pe-idx  { color: color-mix(in oklch, var(--signal-lime) 50%, oklch(0.42 0.01 215)); }

/* ── Loading (sub-diagonal): cyan border only ── */
.pe-cell.pe-loading {
  border-color: color-mix(in oklch, var(--signal-cyan) 45%, var(--hairline-strong));
}

.pe-cell.pe-loading .pe-name { color: color-mix(in oklch, var(--signal-cyan) 70%, var(--muted-foreground)); }

/* ── Weight-loaded: subtle cyan background tint ── */
.pe-cell.pe-weighted {
  background: color-mix(in oklch, var(--signal-cyan) 5%, var(--surface-deep));
}

/*
  Active-MAC shimmer: a single bright stripe sweeps top-to-bottom at a
  constant speed - reads as a scan-line / clock edge, not a heartbeat.
  Each active PE has its own staggered delay so they fire sequentially
  along the diagonal, exactly like data propagating through the array.
*/
@keyframes pe-scan {
  0%   { transform: translateY(-100%) skewY(-8deg); opacity: 0; }
  8%   { opacity: 1; }
  92%  { opacity: 1; }
  100% { transform: translateY(220%) skewY(-8deg); opacity: 0; }
}

.pe-shimmer {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    transparent 0%,
    color-mix(in oklch, var(--signal-lime) 0%,  transparent) 30%,
    color-mix(in oklch, var(--signal-lime) 28%, transparent) 50%,
    color-mix(in oklch, var(--signal-lime) 0%,  transparent) 70%,
    transparent 100%
  );
  mask-image: linear-gradient(180deg, transparent 40%, white 50%, transparent 60%);
  -webkit-mask-image: linear-gradient(180deg, transparent 40%, white 50%, transparent 60%);
  pointer-events: none;
  animation: pe-scan 2200ms cubic-bezier(0.4, 0, 0.6, 1)
             var(--shimmer-delay, 0ms) infinite;
}

