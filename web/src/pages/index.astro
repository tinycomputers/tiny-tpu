---
import Layout from "@/layouts/Layout.astro";
import LandingEmbed from "@/components/LandingEmbed.tsx";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import "@/styles/global.css";

const GITHUB_URL = "https://github.com/tinycomputers/tiny-tpu";

const features = [
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    title: "Synthesizable RTL",
    body: "always_ff · always_comb · zero latches. Real SystemVerilog you can drop into any FPGA synthesis flow.",
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: "Weight-Stationary",
    body: "Matrix B loads as stationary weights into each PE. Authentic TPU-v1 dataflow - not a textbook approximation.",
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    title: "WASM Live Execution",
    body: "Verilator compiles the RTL to C++, Emscripten compiles that to WASM. The browser runs the actual hardware.",
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9S3 16.97 3 12 7.03 3 12 3s9 4.03 9 9z"/></svg>`,
    title: "Golden-Checked",
    body: "RTL output must bit-match a numpy reference model before it earns the right to appear on screen.",
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h7"/><circle cx="17" cy="18" r="3"/></svg>`,
    title: "Debug Output Bus",
    body: "PE weights, activations, partial sums, and FSM phase exposed via a stable top-level debug bus - no hacks.",
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
    title: "Progressive Disclosure",
    body: "L1 single MAC cell → L2 the 4×4 array → L3 tiling matrices larger than the hardware. One concept at a time.",
  },
];

const stats = [
  { value: "4 × 4", label: "Processing elements" },
  { value: "int8", label: "Signed activations" },
  { value: "32-bit", label: "Accumulator width" },
  { value: "WASM", label: "Runtime target" },
];

const pipeline = [
  { step: "01", cmd: "rtl/*.sv", label: "SystemVerilog", note: "PEs, controller FSM, debug output bus" },
  { step: "02", cmd: "verilator --cc", label: "C++ model", note: "Cycle-accurate compiled hardware model" },
  { step: "03", cmd: "em++ -O3", label: "WebAssembly", note: "embind surface, MODULARIZE, ES6 export" },
  { step: "04", cmd: "React island", label: "Signal renderer", note: "SVG pixels from live hardware state" },
];

// Pre-compute PE cells in frontmatter (avoids Astro JSX parser issues with <= operator)
const peCells = Array.from({ length: 16 }, (_, i) => {
  const row = Math.floor(i / 4);
  const col = i % 4;
  const isDiag = row === col;
  const isActive = isDiag;
  const isLoading = row === col + 1;
  const isWeighted = (col === 1 && row === 0) || (col === 2 && row < 2) || (col === 3 && row < 3);
  const cls = ["pe-cell", isActive ? "pe-active" : "", isLoading ? "pe-loading" : "", isWeighted ? "pe-weighted" : ""].filter(Boolean).join(" ");
  // entranceDelay: stagger cells in diagonally (feels like data propagating through array)
  const entranceDelay = (row + col) * 55;
  // shimmerDelay: each active cell gets a unique offset so they don't all pulse together
  const shimmerDelay = row * 400;
  return { row, col, cls, isActive, entranceDelay, shimmerDelay };
});
---

<Layout
  title="TinyTPU — Systolic Array Visualizer | Learn How a TPU Works"
  description="TPU simulator: 4×4 weight-stationary systolic array in synthesizable SystemVerilog, compiled to WebAssembly. Watch real RTL execute live in your browser."
  preloadWasm={true}
>
  <div class="page flex flex-col min-h-screen">

    <!-- ─────────────── NAV ─────────────── -->
    <header class="nav-wrap">
      <nav class="container nav" aria-label="Site navigation">
        <a href="/" class="logo" aria-label="TinyTPU home">
          <span class="logo-text">Tiny<strong>TPU</strong></span>
          <span class="logo-badge">RTL</span>
        </a>

        <div class="nav-links" role="list">
          <a href="#features" role="listitem">Features</a>
          <a href="#pipeline" role="listitem">Pipeline</a>
          <a href="/app" role="listitem">Visualizer</a>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
          >GitHub</a>
        </div>

        <div class="nav-actions">
          <!-- Theme toggle -->
          <button
            id="theme-toggle"
            class="theme-btn"
            aria-label="Switch to light mode"
            title="Toggle theme"
            type="button"
          >
            <!-- Moon: shown in dark mode -->
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <!-- Sun: shown in light mode -->
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </button>

          <a href="/app" class={buttonVariants({ variant: "default", size: "sm" }) + " font-semibold"} id="nav-cta">Open instrument</a>
        </div>
      </nav>
    </header>

    <!-- ─────────────── HERO ─────────────── -->
    <section class="py-20 border-b border-hairline bg-gradient-to-b from-background to-card/10" aria-labelledby="hero-heading">
      <div class="container flex flex-col items-center text-center gap-8">

        <Badge variant="outline" className="py-1.5 px-4 font-mono text-[10px] tracking-wider uppercase flex items-center gap-2 border-border/80 bg-muted/20 text-cyan-400">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          Real hardware · Live in browser
        </Badge>

        <h1 id="hero-heading" class="hero-title text-4xl md:text-6xl font-extrabold tracking-tight text-foreground leading-none">
          A TPU you can<br />
          <em>watch run.</em>
        </h1>

        <p class="hero-sub text-sm md:text-base text-muted-foreground max-w-2xl leading-relaxed">
          TinyTPU is a real 4×4 weight-stationary systolic array written in
          synthesizable SystemVerilog. Compiled to WebAssembly via Verilator
          and Emscripten - every number on screen is a live signal from
          actual hardware. Nothing is faked.
        </p>

        <div class="flex gap-4 flex-wrap justify-center mt-2">
          <a href="/app" class={buttonVariants({ variant: "default", size: "lg" }) + " font-semibold gap-2"} id="hero-cta-primary">
            Open instrument
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline", size: "lg" }) + " font-semibold gap-2"} id="hero-cta-github">
            View on GitHub
          </a>
        </div>

        <!-- Specs Stats Grid (using Shadcn Cards) - Directly Under Hero Texts -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-[860px] mt-10">
          {stats.map((s) => (
            <Card className="bg-card/30 border-border/50 backdrop-blur-sm shadow-sm">
              <CardContent className="flex flex-col items-center justify-center p-6 text-center">
                <div class="font-mono text-2xl font-bold tracking-tight text-foreground">{s.value}</div>
                <div class="text-[10px] text-muted-foreground uppercase tracking-wider font-mono mt-1.5">{s.label}</div>
              </CardContent>
            </Card>
          ))}
        </div>

      </div>
    </section>

    <!-- ─────────────── TELEMETRY (Live capture) ─────────────── -->
    <section class="section border-b border-hairline" id="telemetry" aria-labelledby="telemetry-heading">
      <div class="container">
        <div class="split-layout split-layout--telemetry">

          <!-- Left: copy block -->
          <div class="split-copy">
            <p class="overline overline--amber">Live Telemetry</p>
            <h2 id="telemetry-heading" class="section-title ta-left">
              Real-time RTL<br />Execution Trace.
            </h2>
            <p class="split-body">
              Every clock cycle of the 4×4 systolic array captured directly
              from the WebAssembly-compiled SystemVerilog - weight loading,
              streaming inputs, drained outputs. Every signal is RTL.
            </p>
            <a href="/app" class="inline-link" id="telemetry-open">
              Open full instrument →
            </a>
          </div>

          <!-- Right: live instrument card -->
          <div class="telemetry-card">
            <!-- Card header -->
            <div class="telemetry-card__head">
              <div class="telemetry-card__id">
                <span class="telemetry-card__label">live capture</span>
                <code class="telemetry-card__module">tiny_tpu_top</code>
              </div>
              <div class="telemetry-card__status">
                <span class="clk-dot" aria-hidden="true"></span>
                <span class="telemetry-card__label">clk running</span>
              </div>
            </div>

            <!-- Embed body -->
            <div class="telemetry-card__body">
              <LandingEmbed client:only="react" />
            </div>

            <!-- Card footer -->
            <div class="telemetry-card__foot">
              <span>state source: debug output bus → every signal is RTL</span>
              <a href="/app" class="telemetry-card__cta" id="inst-try">try your own matrices →</a>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ─────────────── FEATURES ─────────────── -->
    <section class="py-24 md:py-32 border-b border-hairline" id="features" aria-labelledby="features-heading">
      <div class="container flex flex-col gap-12">
        <div class="text-center space-y-4 max-w-2xl mx-auto">
          <Badge variant="secondary" className="font-mono text-[10px] uppercase tracking-widest text-cyan-400 bg-cyan-400/10 border-cyan-400/20 py-1 px-3">
            System Specs
          </Badge>
          <h2 id="features-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground leading-tight">
            Built for hardware-curious developers
          </h2>
          <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
            Real synthesizable RTL. Real WASM execution. Real signals. No teaching
            animations, no JS reimplementations of the math.
          </p>
        </div>

        <!-- Spec Grid using Shadcn Card -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <Card className="bg-card/40 border-border/60 hover:border-border transition-colors shadow-sm">
              <CardHeader className="pb-3">
                <div class="font-mono text-[10px] text-cyan-400 uppercase tracking-wider mb-2">0{i+1} / Spec Highlight</div>
                <CardTitle className="text-base font-bold text-foreground">{f.title}</CardTitle>
              </CardHeader>
              <CardContent>
                <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">{f.body}</p>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────── PIPELINE ─────────────── -->
    <section class="py-24 md:py-32 border-b border-hairline bg-muted/5" id="pipeline" aria-labelledby="pipeline-heading">
      <div class="container">
        <div class="split-layout">
          <div class="split-copy">
            <p class="overline">Execution chain</p>
            <h2 id="pipeline-heading" class="section-title ta-left">
              From HDL to pixels.<br />No shadow model.
            </h2>
            <p class="split-body">
              The RTL is the single source of truth. Verilator compiles it to
              a cycle-accurate C++ model. Emscripten compiles that to WebAssembly.
              The React island reads hardware state out of the compiled binary -
              it never reimplements the math in JavaScript.
            </p>
            <div class="mt-6">
              <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline", size: "sm" }) + " font-semibold gap-2"} id="pipeline-view-source">
                View source on GitHub →
              </a>
            </div>
          </div>

          <Card className="overflow-hidden border-border/80 bg-card/30 backdrop-blur-sm shadow-sm">
            <CardContent className="p-0">
              <ol class="pipeline-list" aria-label="Build pipeline steps">
                {pipeline.map((p, i) => (
                  <li class="pipeline-step">
                    <div class="pipe-left">
                      <span class="pipe-num">{p.step}</span>
                      {i < pipeline.length - 1 && <span class="pipe-vert-line"></span>}
                    </div>
                    <div class="pipe-right">
                      <code class="pipe-cmd">{p.cmd}</code>
                      <div class="pipe-label">{p.label}</div>
                      <p class="pipe-note">{p.note}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    <!-- ─────────────── DATAPATH ─────────────── -->
    <section class="py-24 md:py-32 border-b border-hairline" aria-labelledby="datapath-heading">
      <div class="container">
        <div class="split-layout split-layout--reverse">
          <div class="split-copy">
            <p class="overline">Datapath</p>
            <h2 id="datapath-heading" class="section-title ta-left">
              The diagonal<br />is the proof.
            </h2>
            <p class="split-body">
              Matrix B loads as stationary weights. Matrix A streams from the
              west edge with row-skew - row <em>i</em> delayed <em>i</em> cycles
              so each activation meets the correct weight at the right clock edge.
              Partial sums accumulate downward and drain from the south edge, skewed.
            </p>
            <p class="split-note">
              If the diagonal is wrong, the multiply is wrong. That is why the
              interface foregrounds phase, flow, and per-PE state.
            </p>
          </div>

          <Card className="border-border/80 bg-card/30 backdrop-blur-sm shadow-sm">
            <CardContent className="p-5">
              <div class="array-legend" role="presentation">
                <span class="legend-item legend-cyan">
                  <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  A streams (skewed)
                </span>
                <span class="legend-item legend-amber">
                  <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
                  C drains south
                </span>
              </div>

              <div class="pe-grid" role="presentation" aria-label="4×4 systolic array processing elements">
                {peCells.map((pe) => (
                  <div
                    class={pe.cls}
                    style={`--entrance-delay:${pe.entranceDelay}ms;--shimmer-delay:${pe.shimmerDelay}ms`}
                    aria-label={`PE[${pe.row}][${pe.col}]`}
                  >
                    <span class="pe-name">PE</span>
                    <span class="pe-idx">{pe.row},{pe.col}</span>
                    {pe.isActive && <span class="pe-shimmer" aria-hidden="true"></span>}
                  </div>

                ))}

              </div>



              <div class="array-key">

                <span class="key-item key-lime">■ Active MAC</span>

                <span class="key-item key-cyan">■ Weight-loaded</span>

                <span class="key-item key-muted">■ Idle</span>

              </div>

            </CardContent>

          </Card>

        </div>

      </div>

    </section>



    <!-- ─────────────── CTA ─────────────── -->

    <section class="cta-section border-b border-hairline" aria-labelledby="cta-heading">

      <div class="container cta-inner">

        <h2 id="cta-heading" class="cta-title">

          Ready to watch it run?

        </h2>

        <p class="cta-sub">

          Open the instrument. Enter two matrices. Watch actual RTL execute in your browser.

        </p>

        <div class="cta-actions">

          <a href="/app" class={buttonVariants({ variant: "default", size: "lg" }) + " cta-btn-primary"} id="cta-launch">

            Launch visualizer

            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>

          </a>

          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline", size: "lg" }) + " cta-btn-ghost"} id="cta-github">

            Read the RTL

          </a>

        </div>

      </div>

    </section>



    <!-- ─────────────── FOOTER ─────────────── -->
    <footer class="py-16 bg-background border-t border-hairline" role="contentinfo">
      <div class="container grid grid-cols-1 md:grid-cols-2 gap-12 pb-12 border-b border-border/40">

        <div class="flex flex-col gap-4">
          <span class="logo-text text-lg font-bold">Tiny<strong>TPU</strong></span>
          <p class="text-xs text-muted-foreground max-w-xs leading-relaxed">
            A TPU you can watch run - real SystemVerilog systolic array,
            compiled to WASM, visualized live in your browser.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-8">
          <div class="flex flex-col gap-3">
            <div class="font-mono text-[10px] font-semibold tracking-widest text-foreground uppercase">Project</div>
            <a href="/app" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Visualizer</a>
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Source code</a>
            <a href={GITHUB_URL + "/blob/main/CONTEXT.md"} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Architecture</a>
            <a href={GITHUB_URL + "/blob/main/TINYTPU_ROADMAP.md"} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Roadmap</a>
          </div>

          <div class="flex flex-col gap-3">
            <div class="font-mono text-[10px] font-semibold tracking-widest text-foreground uppercase">Stack</div>
            <a href="https://www.veripool.org/verilator/" target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Verilator</a>
            <a href="https://emscripten.org/" target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Emscripten</a>
            <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Astro</a>
            <a href="https://react.dev/" target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">React</a>
          </div>

          <div class="flex flex-col gap-3">
            <div class="font-mono text-[10px] font-semibold tracking-widest text-foreground uppercase">Legal</div>
            <a href={GITHUB_URL + "/blob/main/LICENSE"} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground transition-colors">MIT License</a>
          </div>
        </div>

      </div>

      <div class="container flex flex-col md:flex-row items-center justify-between font-mono text-[9px] uppercase tracking-widest text-muted-foreground/60 pt-6 gap-4">
        <span>© 2026 TinyTPU · MIT License</span>
        <span>Built with SystemVerilog, Verilator, Emscripten, Astro</span>
      </div>
    </footer>

  </div>
</Layout>

<style>
.page {
  min-height: 100vh;
  background: var(--background);
  color: var(--foreground);
  position: relative;
  z-index: 1;
}

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero-wrap {
  padding-block: 80px 64px;
  border-bottom: 1px solid var(--hairline);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 24px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--signal-cyan);
  background: color-mix(in oklch, var(--signal-cyan) 10%, transparent);
  border: 1px solid color-mix(in oklch, var(--signal-cyan) 28%, transparent);
  padding: 5px 12px;
  border-radius: 20px;
}

.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--signal-lime);
  box-shadow: 0 0 0 0 color-mix(in oklch, var(--signal-lime) 50%, transparent);
  animation: badge-pulse 2.5s cubic-bezier(0.66,0,0,1) infinite;
  flex-shrink: 0;
}

@keyframes badge-pulse {
  0%   { box-shadow: 0 0 0 0   color-mix(in oklch, var(--signal-lime) 50%, transparent); }
  70%  { box-shadow: 0 0 0 8px color-mix(in oklch, var(--signal-lime) 0%,  transparent); }
  100% { box-shadow: 0 0 0 0   color-mix(in oklch, var(--signal-lime) 0%,  transparent); }
}

.hero-title {
  font-size: clamp(2.6rem, 5.2vw, 4.8rem);
  font-weight: 680;
  line-height: 1.06;
  letter-spacing: -0.045em;
  color: var(--foreground);
  max-width: 14ch;
}

.hero-title em {
  font-style: italic;
  color: var(--signal-lime);
}

.hero-sub {
  max-width: 600px;
  font-size: 1rem;
  line-height: 1.8;
  color: var(--muted-foreground);
}

.hero-ctas {
